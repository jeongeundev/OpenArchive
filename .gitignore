# --- Node / Next.js ---
node_modules/
.next/
out/
next-env.d.ts
tsconfig.tsbuildinfo

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- 환경변수 / 비밀 ---
.env
.env.*
!.env.example

# --- 임베딩 모델 캐시 (BGE-M3 ~2GB) ---
.cache/
models/

# --- 대회 문서 ---
# 운영규정 PDF는 한국오픈소스협회에 저작권이 있어 저장소에 포함하지 않는다
*.pdf
# 테스트 픽스처는 예외 — 출처·이용 조건은 fixtures/SOURCE.md
!backend/tests/fixtures/*.pdf

# 형식별 평가 자료(#167)는 정책브리핑에서 내려받는다 — 공공누리가 텍스트에 한해서라 내장 이미지를
# 재배포하지 않는다. 출처·해시는 scripts/eval/formats.json, 설명은 SOURCE.md
scripts/eval/formats/*
!scripts/eval/formats/SOURCE.md
!scripts/eval/formats/*.txt

# --- OS / 에디터 ---
.DS_Store
.idea/
*.swp

# 대회 서식 원본
*.docx

# --- 작업 노트 ---
# docs/에는 사용자·기여자용 제품 문서만 둔다. 조사·메모(notes/)와 대회 자료(notes/contest/:
# 과제 정리·평가 기준·결과보고서)는 저장소 밖.
notes/

# --- HA 측정기 기록(scripts/ha_failover.py) ---
ha-runs/

# --- 성능 측정기 실행 산출물 ---
benchmark-results/

# --- 메인테이너 개인 AI 작업 도구 ---
# 하네스(phase 설계·실행·머지 대기 오케스트레이션)와 Claude Code 개인 설정은 저장소 밖에서
# 따로 관리한다. 기여자는 CONTRIBUTING.md의 일반 흐름(브랜치 → 테스트 먼저 → PR)을 따른다.
phases/
scripts/execute.py
scripts/test_execute.py
scripts/ship.py
scripts/test_ship.py
scripts/hooks/
.claude/
CLAUDE.local.md
