# 애플리케이션 환경변수 예시. 설정 디렉토리로 복사해서 쓴다:
#   mkdir -p ~/.openarchive && cp .env.example ~/.openarchive/.env
#
# ⚠️ 앱이 읽는 것은 $OPENARCHIVE_HOME/.env(기본 ~/.openarchive/.env) 하나뿐이다. 설정을 읽는
# openarchive CLI·API·워커·MCP 서버는 실행 디렉토리가 서로 달라서, app/config.py가 이 한 곳만
# 절대경로로 읽어 모두 같은 값을 보게 한다. backend/.env는 더 이상 읽지 않는다.
#
# 저장소 루트의 .env는 다른 파일이다 — 애플리케이션은 읽지 않지만 docker compose가 읽어
# docker-compose.yml의 POSTGRES_* 기본값을 덮는다. 컨테이너 설정은 그쪽, 앱 설정은 여기다.
#
# .env는 저장소에 커밋하지 않는다 (.gitignore).

# 로컬 개발용 pgvector 컨테이너 (docker compose up -d)
DATABASE_URL=postgresql://openarchive:openarchive@localhost:5433/openarchive
# 실 OpenSQL 클러스터로 전환할 때는 이 줄만 OpenProxy VIP 단일 엔드포인트(6432)로 바꾼다 — 코드는 그대로다 (ADR-006).
#   DATABASE_URL=postgresql://app@<vip>:6432/<pool_name>

# 임베딩 프로바이더: fake(테스트·CI, 모델 로딩 없음) | local(BAAI/bge-m3)
EMBEDDING_PROVIDER=fake

# 잡 선점 lease(초). 워커가 처리 중 1/3마다 연장하고, 연장이 끊긴 잡은 이만큼 뒤에 회수된다 (ADR-050).
JOB_LEASE_SECONDS=60
