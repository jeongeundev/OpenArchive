# OpenArchive 임베딩 워커의 systemd **user 유닛** 템플릿.
#
# deploy_app_host.sh가 @APP_ROOT@를 치환해
# ~/.config/systemd/user/openarchive-worker.service 로 설치한다. 이 파일을 직접 편집해
# 쓰지 않는다 — 정본은 여기이고, 설치본은 배포 때마다 다시 만들어진다.
#
# 이 유닛이 있는 이유는 **재부팅 생존이 아니라 crash 복구**다 (ADR-038).
#
#   재부팅 — OpenSQL(Patroni·PostgreSQL·OpenProxy)도 함께 사라지므로 워커만 살려도
#            붙을 DB가 없다. 그래서 [Install] 섹션을 두지 않는다: `systemctl --user
#            enable`이 거부되고 `is-enabled`가 static으로 남아, 부팅 자동 기동이
#            실수로 켜지지 않는다.
#   crash  — DB는 살아 있는데 워커만 죽는 경우다. 되살리지 않으면 임베딩 파이프라인이
#            통째로 멈추고, 새 문서는 영원히 검색되지 않는다. 이쪽만 유닛이 맡는다.
#
# **system 유닛이 아니라 user 유닛인 이유는 SELinux다** (2026-08-19 EC2 실측).
# Rocky 9는 SELinux Enforcing이 기본이고 venv가 홈 아래(user_home_t)에 있어,
# system 유닛(init_t)은 실행 파일을 찾는 단계에서 막힌다 — `203/EXEC Permission denied`.
# `SELinuxContext=`로 exec 도메인만 바꿔도 경로 탐색에서 그대로 걸린다. user 유닛은
# 사용자 세션 매니저가 실행하므로 nohup으로 돌리던 때와 같은 도메인이며, 보안 수준이
# 낮아지지 않는다. 세션이 끊겨도 살아 있도록 `loginctl enable-linger`가 필요하다.

[Unit]
Description=OpenArchive embedding worker

# 메모리 압박으로 죽었다면 즉시 되살려도 또 죽는다. 5분에 5회를 넘으면 포기하고
# failed로 남긴다 — 무한 재기동이 같은 호스트의 API까지 끌어내리는 것을 막는다.
# t3.large 8GB에 BGE-M3가 워커·API 두 벌(합계 4.2GB)로 상주하고 swap이 없다
# (SETUP_OPENSQL.md 측정값). 포기해도 업로드는 계속 받으므로 /admin/status의 pending이
# 계속 올라가 정지 사실은 관측된다 — recovery_pending은 방치된 processing 건수라 크래시
# 시점의 값에서 멈춘다. 한도에 걸린 뒤 다시 띄우려면
# `systemctl --user reset-failed openarchive-worker`가 필요하다 (실측 확인).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# config.py의 `env_file=".env"`가 **상대 경로**다. CWD가 backend/가 아니면 DATABASE_URL·
# EMBEDDING_PROVIDER를 못 읽고 기본값(로컬 컨테이너·fake)으로 조용히 떨어진다.
WorkingDirectory=@APP_ROOT@/backend
ExecStart=@APP_ROOT@/backend/.venv/bin/python -m app.worker

Restart=always
RestartSec=10

# 워커는 SIGTERM을 받으면 처리 중인 잡을 마치고 스스로 멈춘다(run_worker). 임베딩 한
# 건이 끝날 시간을 주고, 그 안에 못 끝내면 systemd가 SIGKILL을 보낸다 — 그때 남는
# 좀비는 다음 워커의 sweep_zombies가 임계(ZOMBIE_TIMEOUT_MINUTES) 후에 회수한다.
KillSignal=SIGTERM
TimeoutStopSec=120

# 로그: journalctl --user -u openarchive-worker -f  (sudo 불필요)
StandardOutput=journal
StandardError=journal
